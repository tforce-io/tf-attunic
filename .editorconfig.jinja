root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,md,toml,yaml,yml}]
indent_style = space

{% for language in languages %}
{% include 'languages/' ~ language ~ '/.editorconfig.jinja' %}
{% endfor %}
