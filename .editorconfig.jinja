root = true

[*]
charset = {{ charset }}
end_of_line = lf
indent_size = {{ indent_size }}
indent_style = {{ indent_style }}
insert_final_newline = true
trim_trailing_whitespace = true

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

[*.md]
indent_style = space

[*.{yaml,yml}]
indent_style = space

{% set blocks = [] -%}
{% for language in languages -%}
{%- set snippet %}{% include 'languages/' ~ language ~ '/.editorconfig.jinja' %}{% endset -%}
{% if snippet | trim %}{% set _ = blocks.append(snippet | trim) %}{% endif -%}
{%- endfor -%}
{{ ((blocks | join('\n\n')) ~ '\n\n' if blocks else '') -}}
# Project-specific
