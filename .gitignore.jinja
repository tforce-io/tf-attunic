{% set blocks = [] -%}
{% for language in languages -%}
{%- set included_languages = ['javascript', language] if language == 'typescript' and 'javascript' not in languages else [language] -%}
{%- for included_language in included_languages -%}
{%- set snippet %}{% include 'languages/' ~ included_language ~ '/.gitignore.jinja' %}{% endset -%}
{% if snippet | trim %}{% set _ = blocks.append(snippet | trim) %}{% endif -%}
{%- endfor -%}
{%- endfor -%}
